{
  "name": "apex-booking-foundation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Apex Kennels Cloudflare booking intake, customer requests and staff invoice-review foundation.",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test src/*.test.ts",
    "demo": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/demo.ts",
    "invoice:preview": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/demo-apex-owner-invoice.ts",
    "invoice:preview:fuel": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/demo-current-fuel-draft.ts",
    "route:check:access": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/run-apex-access-route-check.ts",
    "typecheck": "tsc --noEmit",
    "cf:check": "npm run typecheck && npm test && wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "cf:deploy": "wrangler deploy",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "local:check": "node scripts/check-local.mjs",
    "form:login": "npx --yes @google/clasp@3.4.1 login",
    "form:sync": "node scripts/form-sync.mjs",
    "form:check": "node --check scripts/form-sync.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "22.16.0",
    "typescript": "5.9.3",
    "wrangler": "4.156.2"
  }
}
