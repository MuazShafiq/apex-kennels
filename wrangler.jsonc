{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apex-kennels-api",
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "keep_vars": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "APEX_STAFF_DRAFTS_ENABLED": "true",
    "APEX_PUBLIC_BOOKING_ENABLED": "false"
  },
  "previews": {
    "vars": {
      "APEX_STAFF_DRAFTS_ENABLED": "false"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "LOCATION_SEARCH_BUDGET",
          "class_name": "LocationSearchBudget"
        }
      ]
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOCATION_SEARCH_BUDGET",
        "class_name": "LocationSearchBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "location-search-budget-v1",
      "new_sqlite_classes": [
        "LocationSearchBudget"
      ]
    }
  ]
}
