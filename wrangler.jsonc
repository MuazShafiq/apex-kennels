{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apex-kennels-api",
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "keep_vars": true,
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {
    "APEX_STAFF_DRAFTS_ENABLED": "true"
  },
  "previews": {
    "vars": {
      "APEX_STAFF_DRAFTS_ENABLED": "false"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "LOCATION_SEARCH_BUDGET",
          "class_name": "LocationSearchBudget"
        }
      ]
    },
    "ratelimits": [
      {
        "name": "LOCATION_SEARCH_RATE_LIMIT",
        "namespace_id": "10093011",
        "simple": {
          "limit": 10,
          "period": 60
        }
      },
      {
        "name": "LOCATION_SEARCH_USAGE_LIMIT",
        "namespace_id": "10093012",
        "simple": {
          "limit": 30,
          "period": 60
        }
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOCATION_SEARCH_BUDGET",
        "class_name": "LocationSearchBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "location-search-budget-v1",
      "new_sqlite_classes": [
        "LocationSearchBudget"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "LOCATION_SEARCH_RATE_LIMIT",
      "namespace_id": "10093001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "LOCATION_SEARCH_USAGE_LIMIT",
      "namespace_id": "10093002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
