{
  "name": "apex-booking-foundation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Apex Kennels internal booking ingestion and invoicing foundation. No live form sync yet.",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test src/*.test.ts",
    "demo": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/demo.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm test && npm run compile",
    "compile": "tsc -p tsconfig.build.json",
    "cf:check": "npm run typecheck && npm test && wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "cf:deploy": "wrangler deploy",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "local:check": "node scripts/check-local.mjs",
    "form:login": "npx --yes @google/clasp@3.4.1 login",
    "form:sync": "node scripts/form-sync.mjs",
    "form:check": "node --check scripts/form-sync.mjs"
  },
  "dependencies": {
    "pg": "8.23.1",
    "@neondatabase/serverless": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "22.16.0",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "wrangler": "4.156.2"
  }
}
