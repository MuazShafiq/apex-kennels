{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Apex: Dev server",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Apex: Verify code",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "cf:check"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Apex: Local smoke check",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "local:check"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
