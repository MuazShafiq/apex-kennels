{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apex-kennels-api",
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "keep_vars": true,
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {
    "APEX_STAFF_DRAFTS_ENABLED": "true"
  }
}
